    "zod": "4.3.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.0.16",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.3",
    "prettier": "3.8.2",
    "tailwindcss": "4.3.3",

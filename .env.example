# Public Supabase project values. Safe to expose to browser code, but keep environment-specific.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Needed only by server-side file signing, AI worker routes, and admin provisioning.
# Do not place these values in source control.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only encryption key for any stored AI provider key material.
# Generate a 32-byte base64 value before enabling AI configuration.
AI_CONFIG_ENCRYPTION_KEY=
